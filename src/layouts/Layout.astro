---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { BackgroundEffect } from '../components/islands/BackgroundEffect';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Tonnam · Supakron Klinbubpa',
  description = 'My portfolio/bio website',
  image = 'https://theijon.online/images/tonnam.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="th" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Google Fonts: Space Grotesk (Display) + Nunito (Body) + Geist Mono (Code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Geist+Mono:wght@100..900&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <!-- Devicon CDN -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <ClientRouter />
  </head>
  <body class="antialiased min-h-screen flex flex-col relative" style="background-color: var(--kuro-bg); color: var(--kuro-skull);">
    <BackgroundEffect client:load />
    <div class="flex-1 flex flex-col">
      <slot />
    </div>
    <footer class="mt-auto border-t py-6 px-6 text-xs relative z-10" style="border-color: var(--kuro-border); background: rgba(13, 0, 16, 0.95); color: var(--kuro-muted);">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4" style="font-family: var(--font-mono);">
        <div class="flex items-center gap-3">
          <img src="/kuromi/List-kuromi.webp" alt="Kuromi" class="w-8 h-8 object-contain opacity-75" />
          <p>© {new Date().getFullYear()} Tonnam · Supakron Klinbubpa</p>
        </div>
        <p class="flex items-center gap-2">
          <span class="text-[10px] font-bold uppercase tracking-wider" style="color: var(--kuro-primary-glow);">✦ KUROMI.DEV ✦</span>
          <span style="color: var(--kuro-border-bright);">|</span>
          <a href="#" class="font-bold transition-colors hover:underline" style="color: var(--kuro-pink);">TOP ↑</a>
        </p>
      </div>
    </footer>
  </body>
</html>
