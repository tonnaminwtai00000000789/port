---
import Layout from '../layouts/Layout.astro';
import { HeaderNav } from '../components/islands/HeaderNav';
import { Hero } from '../components/islands/Hero';
import { Work } from '../components/islands/Work';
import { TechStack } from '../components/islands/TechStack';
import { Aboutme } from '../components/islands/Aboutme';
import { BlogsSection } from '../components/islands/BlogsSection';
import { Contact } from '../components/islands/Contact';

import {
  getHeroData,
  getAboutMeData,
  getTechStackData,
  getWorksData,
  getContactData,
  getBlogPosts,
} from '../lib/data';

const hero = await getHeroData();
const aboutMe = await getAboutMeData();
const techStack = await getTechStackData();
const works = await getWorksData();
const contact = await getContactData();
const posts = await getBlogPosts();
---

<Layout
  title={hero?.displayName ? `${hero.displayName} · Digital Craftsman` : 'TonnamInwtai00789'}
  description={hero ? `Developer based in ${hero.location}. ${hero.displayName}` : 'Personal portfolio'}
  image={hero?.profileImage}
>
  <HeaderNav client:load webringUrl={hero?.webringUrl} />

  <main class="mx-auto max-w-6xl px-6 flex-1 w-full space-y-12">
    {hero && <Hero client:load data={hero} />}
    {works && works.length > 0 && <Work client:visible data={works} />}
    {techStack && techStack.length > 0 && <TechStack client:visible data={techStack} />}
    {aboutMe && <Aboutme client:visible data={aboutMe} />}
    {posts && posts.length > 0 && <BlogsSection client:visible data={posts} />}
    {contact && <Contact client:visible data={contact} />}
  </main>

  <footer class="mt-20 border-t border-slate-200 bg-white py-8 text-center text-xs font-semibold text-slate-500">
    <div class="mx-auto max-w-6xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {new Date().getFullYear()} Supakron Klinbubpa (Tonnam). All rights reserved.</p>
      <p class="text-slate-400">Crafted with Astro 5, React Islands & Supabase on Bun</p>
    </div>
  </footer>
</Layout>
