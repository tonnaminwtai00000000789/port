---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, ExternalLink, Github } from 'lucide-react';
import { getWorksData, getHeroData } from '../lib/data';

const works = await getWorksData();
const hero = await getHeroData();
const displayName = hero?.displayName || 'TonnamInwtai00789';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600, stale-while-revalidate=3600');
---

<Layout title={`Tonnam · ผลงานทั้งหมด`}>
  <div class="min-h-screen bg-[#f7f7f2] py-10 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="flex items-center gap-4 mb-12">
        <a
          href="/"
          class="p-2.5 bg-white border-1.5 border-[#161616] shadow-[2px_2px_0px_#161616] hover:translate-x-0.5 transition-all text-[#161616]"
        >
          <ArrowLeft className="w-5 h-5" />
        </a>
        <div>
          <span class="text-xs font-mono font-bold text-[#ff4500] uppercase">WORKS ARCHIVE</span>
          <h1 class="text-3xl font-black text-[#161616] font-display">ผลงานทั้งหมด</h1>
        </div>
      </div>

      <!-- Works Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {works.map((work) => (
          <div class="card-paper overflow-hidden bg-white border-1.5 border-[#161616] flex flex-col justify-between">
            <div class="aspect-video overflow-hidden relative border-b-1.5 border-[#161616]">
              <img
                src={work.image}
                alt={work.title}
                class="w-full h-full object-cover"
              />
              <span class="absolute top-2 right-2 px-2 py-0.5 bg-[#161616] text-white text-[10px] font-mono font-bold border border-white">
                {work.year}
              </span>
            </div>

            <div class="p-5 flex flex-col justify-between flex-1 space-y-4">
              <div class="space-y-2">
                <h2 class="text-xl font-extrabold text-[#161616]">
                  {work.title}
                </h2>
                <p class="text-[#525252] text-xs leading-relaxed">{work.description}</p>

                {work.tags && work.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1 pt-1">
                    {work.tags.map((tag: any) => (
                      <span class="tag-badge">
                        {tag.label}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="flex items-center gap-2 pt-2 border-t border-[#e2e2d8]">
                {work.links?.map((link: any) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noreferrer"
                    class="px-3 py-1.5 bg-[#161616] text-white hover:bg-[#ff4500] text-xs font-bold transition-colors inline-flex items-center gap-1 border border-[#161616]"
                  >
                    {link.type === 'website' ? (
                      <>
                        เปิดเว็บไซต์ <ExternalLink className="w-3 h-3" />
                      </>
                    ) : (
                      <>
                        ดูซอร์สโค้ด <Github className="w-3 h-3" />
                      </>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
