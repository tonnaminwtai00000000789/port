---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, ExternalLink, Github } from 'lucide-react';
import { getWorksData, getHeroData } from '../lib/data';

const works = await getWorksData();
const hero = await getHeroData();
const displayName = hero?.displayName || 'TonnamInwtai00789';
---

<Layout title={`${displayName} · Works Archive`}>
  <div class="min-h-screen bg-slate-50 py-12 px-6">
    <div class="max-w-6xl mx-auto">
      {/* Header */}
      <div class="flex items-center gap-4 mb-16">
        <a
          href="/"
          class="p-3 bg-white border border-slate-200 rounded-2xl shadow-xs hover:border-indigo-600 hover:text-indigo-600 transition-all text-slate-600"
        >
          <ArrowLeft className="w-5 h-5" />
        </a>
        <div>
          <span class="text-xs font-bold text-indigo-600 tracking-wider uppercase">CRAFTSMANSHIP</span>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Recent Projects</h1>
        </div>
      </div>

      {/* Works Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {works.map((work, index) => (
          <div class="card-light rounded-[32px] overflow-hidden bg-white group border border-slate-200/80 flex flex-col justify-between">
            <div class="aspect-video relative overflow-hidden bg-slate-100">
              <img
                src={work.image}
                alt={work.title}
                loading={index < 2 ? 'eager' : 'lazy'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 right-4">
                <span class="px-3.5 py-1 rounded-full bg-white/90 backdrop-blur-md border border-slate-200 text-slate-800 text-xs font-bold shadow-xs">
                  {work.year}
                </span>
              </div>
            </div>

            <div class="p-8 flex flex-col justify-between flex-1">
              <div className="space-y-3 mb-6">
                <h2 class="text-2xl font-extrabold text-slate-900 group-hover:text-indigo-600 transition-colors">
                  {work.title}
                </h2>
                <p class="text-slate-600 text-sm font-medium leading-relaxed">{work.description}</p>

                {work.tags && work.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-2">
                    {work.tags.map((tag: any) => (
                      <span class="px-3 py-1 rounded-lg bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-bold">
                        {tag.label}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                {work.links?.map((link: any) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noreferrer"
                    class="px-4 py-2 rounded-xl bg-slate-900 text-white hover:bg-indigo-600 text-xs font-bold transition-colors inline-flex items-center gap-1.5 shadow-sm"
                  >
                    {link.type === 'website' ? (
                      <>
                        Visit Website <ExternalLink className="w-3.5 h-3.5" />
                      </>
                    ) : (
                      <>
                        View Code <Github className="w-3.5 h-3.5" />
                      </>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
