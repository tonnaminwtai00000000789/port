---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Clock } from 'lucide-react';
import { getBlogPostBySlug } from '../../lib/data';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blogs');
}

const post = await getBlogPostBySlug(slug);

if (!post) {
  return Astro.redirect('/404');
}
---

<Layout title={`${post.title} · Blog`}>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <!-- Blog Header Image -->
    <div class="w-full h-[40vh] md:h-[50vh] relative overflow-hidden group">
      <img
        src={post.image}
        alt={post.title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent"></div>

      <!-- Navigation -->
      <div class="absolute top-8 left-6 z-10">
        <a
          href="/blogs"
          class="flex items-center gap-2 text-white bg-slate-900/60 hover:bg-slate-900 px-4 py-2 rounded-xl backdrop-blur-md transition border border-white/20 text-xs font-bold"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Back to Blogs</span>
        </a>
      </div>

      <!-- Title overlay -->
      <div class="absolute bottom-0 left-0 w-full p-6 md:p-12 text-white">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-2 mb-3 text-indigo-300 font-bold text-xs">
            <Clock className="w-4 h-4" />
            <span>{post.date}</span>
          </div>
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black leading-tight drop-shadow-md tracking-tight">
            {post.title}
          </h1>
        </div>
      </div>
    </div>

    <!-- Content Container -->
    <div class="max-w-3xl mx-auto px-6 py-12">
      <div class="card-light p-8 md:p-12 rounded-[32px] bg-white border border-slate-200/80">
        <article class="prose prose-slate max-w-none">
          <div class="whitespace-pre-wrap font-sans text-slate-700 leading-relaxed text-base md:text-lg">
            {post.content}
          </div>
        </article>

        <div class="mt-12 pt-8 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-slate-500">
          <p>Thanks for reading!</p>
          <a href="/blogs" class="text-indigo-600 hover:text-indigo-800 transition-colors">
            Read more posts →
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
