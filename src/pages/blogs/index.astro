---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Clock, ChevronRight } from 'lucide-react';
import { getBlogPosts } from '../../lib/data';

const blogs = await getBlogPosts();
---

<Layout title="Tonnam · บล็อกทั้งหมด">
  <div class="min-h-screen bg-[#f7f7f2] py-10 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="flex items-center gap-4 mb-12">
        <a
          href="/"
          class="p-2.5 bg-white border-1.5 border-[#161616] shadow-[2px_2px_0px_#161616] hover:translate-x-0.5 transition-all text-[#161616]"
        >
          <ArrowLeft className="w-5 h-5" />
        </a>
        <div>
          <span class="text-xs font-mono font-bold text-[#ff4500] uppercase">WRITINGS</span>
          <h1 class="text-3xl font-black text-[#161616] font-display">บทความทั้งหมด</h1>
        </div>
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {blogs.map((blog) => (
          <a
            href={`/blogs/${blog.slug}`}
            class="card-paper overflow-hidden bg-white border-1.5 border-[#161616] flex flex-col justify-between"
          >
            <div class="aspect-[16/10] overflow-hidden relative border-b-1.5 border-[#161616]">
              <img
                src={blog.image}
                alt={blog.title}
                class="w-full h-full object-cover"
              />
              <span class="absolute top-2 left-2 px-2 py-0.5 bg-[#161616] text-white text-[10px] font-mono font-bold flex items-center gap-1 border border-white">
                <Clock className="w-3 h-3 text-[#ff4500]" /> {blog.date}
              </span>
            </div>

            <div class="p-4 flex flex-col justify-between flex-1">
              <h2 class="text-base font-extrabold text-[#161616] hover:text-[#ff4500] transition-colors line-clamp-2 mb-3 leading-snug">
                {blog.title}
              </h2>

              <div class="pt-2 border-t border-[#e2e2d8] flex items-center justify-between text-xs font-bold text-[#ff4500]">
                <span>อ่านต่อ</span>
                <ChevronRight className="w-3.5 h-3.5" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
