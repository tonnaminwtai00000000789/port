---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Clock, ChevronRight } from 'lucide-react';
import { getBlogPosts } from '../../lib/data';

const blogs = await getBlogPosts();
---

<Layout title="TonnamInwtai00789 · Writing Archive">
  <div class="min-h-screen bg-slate-50 py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="flex items-center gap-4 mb-16">
        <a
          href="/"
          class="p-3 bg-white border border-slate-200 rounded-2xl shadow-xs hover:border-indigo-600 hover:text-indigo-600 transition-all text-slate-600"
        >
          <ArrowLeft className="w-5 h-5" />
        </a>
        <div>
          <span class="text-xs font-bold text-indigo-600 tracking-wider uppercase">WRITINGS</span>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">All Blog Posts</h1>
        </div>
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {blogs.map((blog, index) => (
          <a
            href={`/blogs/${blog.slug}`}
            class="card-light rounded-[32px] overflow-hidden bg-white group border border-slate-200/80 flex flex-col justify-between"
          >
            <div class="aspect-[16/10] overflow-hidden relative bg-slate-100">
              <img
                src={blog.image}
                alt={blog.title}
                loading={index < 2 ? 'eager' : 'lazy'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 left-4">
                <span class="px-3.5 py-1 rounded-full bg-white/90 backdrop-blur-md border border-slate-200 text-slate-700 text-xs font-bold shadow-xs inline-flex items-center gap-1.5">
                  <Clock className="w-3 h-3 text-indigo-600" /> {blog.date}
                </span>
              </div>
            </div>

            <div class="p-6 flex flex-col justify-between flex-1">
              <h2 class="text-xl font-extrabold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-2 mb-4 leading-snug">
                {blog.title}
              </h2>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-indigo-600">
                <span>Read Article</span>
                <ChevronRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
